<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ============================================
    INFRASTRUCTURE LAYER - Data Access
    ============================================
    Contains: EF Core DbContext, Repository implementations, DI registration
    Dependencies: Application + Domain layers
    This layer knows HOW to persist data.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SharpCuts.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpCuts.Domain\SharpCuts.Domain.csproj" />
    <ProjectReference Include="..\SharpCuts.Application\SharpCuts.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Entity Framework Core - ORM for database access -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    
    <!-- InMemory provider (for development - replace with SQL Server in production) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.0" />
    
    <!-- SQL Server provider (for production) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    
    <!-- ASP.NET Core integration -->
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
  </ItemGroup>
</Project>
