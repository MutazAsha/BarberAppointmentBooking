<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ============================================
    APPLICATION LAYER (Use Cases Layer)
    ============================================
    طبقة حالات الاستخدام - تحتوي على منطق العمل
    
    تحتوي على:
    - Use Cases / Services (حالات الاستخدام)
    - DTOs (كائنات نقل البيانات)
    - Interfaces (واجهات للمستودعات والخدمات)
    - Validators (المدققات)
    - Mappers (المحولون)
    
    تعتمد فقط على Domain Layer
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SharpCuts.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- الاعتماد على Domain Layer فقط -->
    <ProjectReference Include="..\SharpCuts.Domain\SharpCuts.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BCrypt لتشفير كلمات المرور -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    
    <!-- JWT للمصادقة -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.0.3" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="7.0.3" />
    
    <!-- Microsoft.Extensions للـ DI -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>
</Project>
